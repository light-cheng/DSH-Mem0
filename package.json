{
  "name": "dsh-mem0",
  "version": "0.3.1",
  "private": false,
  "description": "Mem0 long-term memory for DeepSeek Harness: managed Platform, self-hosted server or local OSS, with a visual settings page, automatic recall/capture, editable memory summary, token budgets and weekly memory hygiene.",
  "icon": "assets/icon.png",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "python",
    "examples",
    "assets",
    "screenshots.json",
    "cordis.patch.yml",
    "locale/*.json",
    "docs/plugin-page.en.md",
    "docs/plugin-page.zh-CN.md",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "RELEASE.md",
    "MARKETPLACE.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check-syntax.mjs",
    "smoke": "node scripts/smoke-sidecar.mjs"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "mem0",
    "memory",
    "long-term-memory",
    "rag"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Light Cheng (https://github.com/light-cheng)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/light-cheng/DSH-Mem0.git"
  },
  "homepage": "https://github.com/light-cheng/DSH-Mem0#readme",
  "bugs": {
    "url": "https://github.com/light-cheng/DSH-Mem0/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  }
}
